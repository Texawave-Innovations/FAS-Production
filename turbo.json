{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"],
      // packages/database's build (`prisma generate`) needs DATABASE_URL to
      // be *present* in the environment to load its Prisma config, even
      // though it never connects to it — without this, turbo's env
      // filtering silently drops the var and the build fails with
      // "Missing required environment variable: DATABASE_URL" even when
      // it's exported in the calling shell/CI job (verified: this is what
      // was actually happening before this line existed).
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
