{
  "name": "@fas-erp/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, and seed scripts — the single source of truth for the data model. Owned/consumed by apps/api via the generated Prisma client. Phase 1 — platform layer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fas-erp/core": "workspace:^",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@fas-erp/config": "workspace:*",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
