{
  "name": "@fas-erp/ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design-system primitives (web-focused, used by apps/ui).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@fas-erp/config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "react": "^19.2.8",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
}
