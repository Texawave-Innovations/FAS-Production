{
  "name": "@fas-erp/ui-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design-system primitives (web-focused, used by apps/ui). Empty scaffold — Phase 0.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": ["dist", "src/theme.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@fas-erp/config": "workspace:*",
    "eslint": "^10.10.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.0"
  }
}
