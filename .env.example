# Copy to .env (root) and/or packages/database/.env for local development.
# Matches docker-compose.yml at the repo root.

# --- packages/database (Prisma) / apps/api ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fas_erp_dev?schema=public"

# --- apps/api (cache, sessions, rate limiting, permission-set caching) ---
REDIS_URL="redis://localhost:6379"

# --- apps/api (server) ---
NODE_ENV="development"
API_PORT="3001"
UI_ORIGIN="http://localhost:3000"

# --- apps/api (platform/auth) — generate real secrets per environment, e.g. `openssl rand -hex 48` ---
JWT_ACCESS_SECRET="changeme-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="changeme-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- apps/ui ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
