# Copy to .env (root) and/or packages/database/.env for local development.
# Matches docker-compose.yml at the repo root.

# --- packages/database (Prisma) / apps/api ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fas_erp_dev?schema=public"

# --- apps/api (cache, sessions, rate limiting, permission-set caching) ---
REDIS_URL="redis://localhost:6379"
